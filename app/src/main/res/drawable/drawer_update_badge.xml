<?xml version="1.0" encoding="utf-8"?>
<!-- Pill behind the "N updates" badge on the drawer AI-assistant header.
     Fixed green: the theme accent is near-black and would vanish on the
     dark drawer. White text on this green reads in both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2E7D32" />
    <corners android:radius="9dp" />
    <padding
        android:left="7dp"
        android:top="2dp"
        android:right="7dp"
        android:bottom="2dp" />
</shape>
