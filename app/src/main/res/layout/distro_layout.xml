<?xml version="1.0" encoding="utf-8"?>
<!-- Linux distro manager screen. Same structure as activity_settings.xml:
     shared primary toolbar on top, content list below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/partial_primary_toolbar"
        android:id="@+id/partial_primary_toolbar" />

    <ListView
        android:id="@+id/distro_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/distro_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/distro_status_loading" />

</LinearLayout>
